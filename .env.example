# ---- required (the API refuses to start without these) ----
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
FLIGHT_VENDOR_TOKEN=            # Duffel access token (duffel_test_… for test mode)
CASHFREE_APP_ID=
CASHFREE_API_KEY=

# ---- optional ----
CASHFREE_ENV=sandbox            # sandbox | production
CASHFREE_WEBHOOK_URL=           # public https URL of /api/webhooks/cashfree (none locally: /sync covers it)

DATABASE_URL=postgresql+asyncpg://flight_user:flight_password@localhost:5432/flight_booking

# Auth: firebase (default, verifies Firebase ID tokens) | demo (no sign-in; tests and curl only)
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=mks-agent-console
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099   # LOCAL ONLY: accepts unsigned emulator tokens
# DEMO_USER_ID=                                # user for AUTH_MODE=demo

LOG_LEVEL=INFO
CORS_ORIGINS=                   # extra allowed browser origins, comma-separated
